# RAG 配置示例 - 优化后的推荐配置

# ============================================
# 依赖召回优化配置
# ============================================

# seed选择阈值：从0.7降低到0.6，降低seed选择门槛，确保关键依赖证据不被过滤
RAG_DEPENDENCY_SEED_SCORE_RATIO=0.6

# 最大seed数量：从8增加到10，允许更多seed参与依赖扩展
RAG_DEPENDENCY_MAX_SEEDS=10

# 依赖能力权重：0.3表示seed评分=70%召回分数+30%依赖能力评分
# 范围：0.0-0.5，值越大越倾向选择有依赖能力证据的chunk
RAG_DEPENDENCY_SEED_CAPABILITY_WEIGHT=0.3

# 依赖证据总量上限：从12增加到16，增加依赖证据容量
RAG_DEPENDENCY_TOTAL_LIMIT=16

# 强制依赖证据上限：最多追加15个强制依赖证据到最终上下文
RAG_DEPENDENCY_MAX_FORCED_DEPS=15

# 单个seed的依赖上限：保持5不变
RAG_DEPENDENCY_PER_SEED_LIMIT=5

# 依赖边最低置信度：保持0.7不变
RAG_DEPENDENCY_MIN_CONFIDENCE=0.7

# ============================================
# 重排和上下文配置
# ============================================

# 最终TopN：从5增加到8，增加最终上下文容量，减少信息截断
RAG_RERANK_FINAL_TOP_N=8

# LLM重排TopN：保持10不变
RAG_RERANK_LLM_TOP_N=10

# ============================================
# 其他召回配置
# ============================================

# 向量召回topk
RAG_RETRIEVAL_CONTENT_TOP_K=8
RAG_RETRIEVAL_SUMMARY_TOP_K=6
RAG_RETRIEVAL_BM25_TOP_K=8

# 改写召回topk
RAG_RETRIEVAL_REWRITE_CONTENT_TOP_K=4
RAG_RETRIEVAL_REWRITE_SUMMARY_TOP_K=3
RAG_RETRIEVAL_REWRITE_BM25_TOP_K=4

# 邻居扩展
RAG_RETRIEVAL_NEIGHBOR_ENABLED=true
RAG_RETRIEVAL_NEIGHBOR_RADIUS=1
RAG_RETRIEVAL_CENTER_TOP_K=5

# ============================================
# 实验性配置（需要A/B测试）
# ============================================

# 如果仍有干扰文档问题，可以尝试调整：
# RAG_DEPENDENCY_SEED_CAPABILITY_WEIGHT=0.4  # 进一步提高依赖能力权重
# RAG_DEPENDENCY_SEED_SCORE_RATIO=0.5  # 进一步降低阈值

# 如果依赖证据仍然不足，可以尝试：
# RAG_DEPENDENCY_TOTAL_LIMIT=20
# RAG_DEPENDENCY_MAX_FORCED_DEPS=20
# RAG_RERANK_FINAL_TOP_N=10
